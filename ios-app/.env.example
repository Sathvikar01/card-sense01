# Copy to .env.local (or set as EAS environment variables) and fill in.
# The website's public address. The card catalogue, the advisor and every website link use it.
EXPO_PUBLIC_WEB_URL=
# The Supabase project the website uses: the same public URL and anon key. Needed for native sign-in;
# without them the Account tab signs in on the website instead.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
